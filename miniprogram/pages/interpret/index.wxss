.interpret-hero{padding-bottom:26rpx}.topic-list{display:flex;flex-wrap:wrap;gap:14rpx;margin:0 0 30rpx}.interpret-empty,.interpret-controls{display:flex;flex-direction:column}.interpret-empty .muted{margin:20rpx 0 28rpx}.interpret-empty .button{width:100%}.chart-summary{font-size:25rpx;color:#d7c6a4;line-height:1.9;margin:18rpx 0 24rpx}.token-heading{display:flex;justify-content:space-between;align-items:center;margin:32rpx 0 16rpx}.token-note{font-size:22rpx}.token-input{box-sizing:border-box;width:100%;min-height:92rpx;height:92rpx;padding:0 24rpx;background:#111b1c;color:#eee8db;border:1rpx solid #485647;border-radius:12rpx;font-size:29rpx}.token-placeholder{color:#829084;font-size:26rpx}.token-hint{margin-top:12rpx;font-size:22rpx}.consent-row{display:flex;align-items:flex-start;font-size:23rpx;line-height:1.9;color:#aab4a8;margin:32rpx 0 24rpx}.consent-row checkbox{flex-shrink:0;transform:scale(.78);transform-origin:top left;width:48rpx;margin-top:5rpx}.consent-row text{flex:1}.interpret-generate{margin:0;width:100%}.progress-message{font-size:23rpx;margin-top:24rpx;line-height:1.9}.analysis-results{margin-top:28rpx}.analysis-section{margin-bottom:24rpx}.analysis-summary{display:block;font-size:33rpx;color:#eee3ce;line-height:1.8;margin:20rpx 0 32rpx;word-break:break-all}.analysis-subheading{display:block;font-size:25rpx;color:#d4b880;margin:28rpx 0 14rpx}.analysis-item{display:flex;align-items:flex-start;color:#b8c4b3;font-size:26rpx;line-height:1.95;margin:12rpx 0;word-break:break-all}.analysis-dot{flex-shrink:0;width:28rpx;color:#d4b880;font-weight:600}.analysis-item>text:last-child{flex:1;min-width:0}.interpret-disclaimer{margin:30rpx 0 10rpx}
