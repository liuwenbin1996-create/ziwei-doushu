.history-hero{padding-bottom:30rpx}.history-heading{margin:34rpx 0 22rpx;justify-content:space-between;align-items:center}.history-clear,.record-delete{background:transparent;color:#cf9a88;font-size:25rpx;margin:0;padding:0 12rpx;min-width:96rpx;line-height:80rpx}.history-clear::after,.record-delete::after{border:none}.history-empty{display:flex;flex-direction:column;align-items:center;text-align:center;padding:48rpx 28rpx}.history-empty-symbol{font-size:70rpx;line-height:1.4;color:#d4b880;margin-bottom:20rpx}.history-empty .muted{margin-top:18rpx}.history-start{margin-top:32rpx;width:100%}.history-record{margin-bottom:22rpx}.record-content{display:flex;flex-direction:column;padding:4rpx 0 24rpx;min-height:130rpx}.record-date{font-size:34rpx;font-weight:500;color:#e8d8b9;margin-bottom:10rpx;letter-spacing:2rpx}.record-saved{font-size:22rpx;color:#8e9c91;margin-top:10rpx}.record-actions{display:flex;align-items:center;gap:20rpx;border-top:1rpx solid #344239;padding-top:20rpx}.record-open{flex:1;margin:0}.record-delete{flex-shrink:0;min-width:104rpx}.history-footnote{margin:36rpx 4rpx 16rpx;font-size:23rpx;line-height:1.9}
